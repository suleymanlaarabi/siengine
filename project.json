{
  "id": "siengine",
  "type": "package",
  "value": {
    "author": "Suleyman Laarabi",
    "description": "siecs based game engine",
    "clangd": true,
    "use": ["siecs", "sicore", "siphysics"]
  },
  "bundle": {
    "repositories": {
      "siecs": "https://github.com/suleymanlaarabi/siecs",
      "siphysics": "https://github.com/suleymanlaarabi/siphysics"
    }
  },
  "lang.c": {
    "c-standard": "c23",
    "lib": ["SDL3", "SDL3_ttf", "SDL3_image", "m"],
    "include": ["src"],
    "export-symbols": true
  }
}
